<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RubySage — Edit <%= @chunk.title %></title>
  <%= render "styles" %>
</head>
<body>
<header class="rs-admin-header">
  <h1>RubySage</h1>
  <span class="rs-admin-badge">Edit knowledge entry</span>
</header>
<div class="rs-admin-body">
  <div class="rs-admin-card">
    <%= render "form",
                chunk: @chunk,
                form_url: ruby_sage.admin_knowledge_chunk_path(@chunk),
                form_method: :patch,
                submit_label: "Save changes" %>
  </div>
</div>
</body>
</html>
